# Copy to .env and adjust. Every value is required; there are no defaults in code.

# Port the HTTP server listens on.
PORT=8080

# zerolog level: trace, debug, info, warn, error, fatal, panic.
LOG_LEVEL=info

# Path to the SQLite database file.
DB_PATH=mealprep.db

# Open Food Facts base URL. Optional; this is the default.
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org

# Open Food Facts search host. Optional; this is the default.
OPEN_FOOD_FACTS_SEARCH_URL=https://search.openfoodfacts.org
